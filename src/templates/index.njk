<section class="wrap sec sec--tight" aria-label="Templates">
  <ul class="tpl-list">
    {%- for t in templates %}
    <li class="jc-card tpl-card">
      <h2 class="tpl-card__title"><a href="/templates/{{ t.slug }}/">{{ t.name }}</a></h2>
      <p>{{ t.summary }}</p>
      <span class="tpl-card__meta">US Letter, 1 page · PDF</span>
    </li>
    {%- endfor %}
  </ul>
  <p class="tpl-note">Jobchit, when it opens, fills these in on your phone and gets them signed on the spot. <a href="/#waitlist">Join the waitlist</a>.</p>
</section>
